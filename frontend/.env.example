# Frontend Environment Variables (Vercel / Vite)
# For local dev with Vite proxy, leave as /api.
# For production (e.g. Vercel -> Render backend), set to your Render API base URL:
# VITE_API_BASE_URL=https://sahayak-ai-api.onrender.com/api
VITE_API_BASE_URL=/api

# Google Identity Services Client ID (from Google Cloud Console)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
