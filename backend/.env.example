# Sahayak AI Backend Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env to version control.

ENVIRONMENT=development
ALLOW_DEMO_MODE=true
LOG_LEVEL=INFO

GEMINI_API_KEY=AQ.Ab8RN6L8ODByS8mumnwuLqqQqplKsYABY-kXAkvAKUQ1tpm2Cg
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sahayak_ai
MONGODB_MAX_POOL_SIZE=50

# In production, set JWT_SECRET (>=32 chars) and ADMIN_API_KEY (>=24 chars) to strong random strings.
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DATA_GOV_API_KEY=579b464db66ec23bdd000001340130e7feb2410f76f9c0aa3ab78116
ADMIN_API_KEY=sahayak-admin-dev

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=240
TRUST_PROXY_HEADERS=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
B2B_API_BASE_URL=http://localhost:4000
INTER_SERVICE_SECRET=replace-with-shared-64-char-hmac-secret
SYNC_TIMEOUT_SECONDS=8
